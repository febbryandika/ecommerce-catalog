# Local Postgres from docker-compose.yml. Points at Neon in deployed envs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/ecommerce_catalog

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Anthropic, for the streaming description generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Cloudflare R2 product image storage. R2_PUBLIC_URL is the bucket's public URL —
# https://pub-<hash>.r2.dev or a custom domain — with no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
